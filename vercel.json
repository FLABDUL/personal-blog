{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "residuelens.com" }],
      "destination": "https://www.madebyhakim.com/projects/residue-lens/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.residuelens.com" }],
      "destination": "https://www.madebyhakim.com/projects/residue-lens/",
      "statusCode": 301
    }
  ],
  "crons": [{ "path": "/api/spotify-refresh/", "schedule": "0 6 * * *" }]
}
