{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/demos/period-place/",
      "destination": "https://periodplace.org/",
      "statusCode": 302
    },
    {
      "source": "/projects/residue-lens-demo/",
      "destination": "https://residuelens.com/",
      "statusCode": 302
    },
    {
      "source": "/demos/period-place/:path*",
      "destination": "https://periodplace.org/:path*",
      "statusCode": 302
    },
    {
      "source": "/projects/residue-lens-demo/:path*",
      "destination": "https://residuelens.com/:path*",
      "statusCode": 302
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "periodplace.madebyhakim.com"
        }
      ],
      "destination": "https://www.madebyhakim.com/projects/period-place/",
      "statusCode": 301
    }
  ],
  "crons": [
    {
      "path": "/api/spotify-refresh/",
      "schedule": "0 6 * * *"
    }
  ]
}
