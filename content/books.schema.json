{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "author", "added", "category"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": { "type": "string", "minLength": 1 },
      "author": { "type": "string", "minLength": 1 },
      "cover": {
        "type": "string",
        "pattern": "^/books/[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:jpg|jpeg|png|webp)$"
      },
      "added": { "type": "string", "format": "date" },
      "category": {
        "enum": [
          "Software Engineering",
          "Technology",
          "Finance",
          "Health & Science",
          "Personal Growth",
          "Other"
        ]
      }
    }
  }
}
