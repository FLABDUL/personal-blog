{
  "name": "personal-blog",
  "version": "0.1.0",
  "private": true,
  "description": "A Gatsby + MDX personal blog",
  "author": "Abdul Hakim Norazman",
  "scripts": {
    "predevelop": "node scripts/cv/validate.js && node scripts/books/validate.js",
    "develop": "gatsby develop",
    "prebuild": "node scripts/cv/validate.js && node scripts/books/validate.js && node scripts/cv/generate.js",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "cv:validate": "node scripts/cv/validate.js",
    "cv:generate": "node scripts/cv/generate.js",
    "cv:check": "node scripts/cv/validate.js && node scripts/cv/generate.js --check",
    "cv:compare": "node scripts/cv/compare.js",
    "cv:latex": "node scripts/cv/validate.js && node scripts/cv/generate-latex.js --variant swe",
    "cv:pdf": "npm run cv:latex && node scripts/cv/compile-pdf.js --variant swe",
    "cv:setup-pdf": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cv/install-tectonic.ps1",
    "books:validate": "node scripts/books/validate.js",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\""
  },
  "dependencies": {
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2",
    "gatsby": "5.14.4",
    "gatsby-plugin-image": "3.11.0",
    "gatsby-plugin-react-helmet": "6.14.0",
    "gatsby-plugin-sharp": "5.14.0",
    "gatsby-remark-images": "7.14.0",
    "gatsby-remark-prismjs": "^7.14.0",
    "gatsby-source-filesystem": "5.14.0",
    "gatsby-transformer-remark": "^6.14.0",
    "gatsby-transformer-sharp": "5.14.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "mammoth": "^1.10.0",
    "pdf-parse": "^1.1.1",
    "prettier": "^2.8.8"
  },
  "keywords": [
    "gatsby",
    "react"
  ],
  "license": "MIT"
}
